# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.so

# Testing / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Hypothesis writes its own `.hypothesis/.gitignore` containing `*`, so git has always
# skipped this -- which is why it is easy to miss that nothing else does. The sdist builder
# does not read nested ignore files, and shipped 328 cache files until it was named here.
.hypothesis/
.coverage
coverage.xml
htmlcov/

# pixi
.pixi/
# keep pixi.lock committed for reproducible dev envs

# Env / editors
.venv/
venv/
.env
.idea/
.vscode/
.DS_Store

# sentrykit local artifacts (never commit real audit logs or secrets)
*.audit.jsonl
secrets.local.*

# The example apps' demo database, when SENTRYKIT_DEMO_DB points at a file rather than
# letting it live in memory. Seeded from code and reproducible, so there is nothing here
# worth committing and a stale copy is worse than none.
examples/.demo/

# Local research workspace (not shipped, not committed)
/research/
